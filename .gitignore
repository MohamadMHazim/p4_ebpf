# Python caches
__pycache__/
*.py[cod]

# Vendored libbpf-bootstrap build outputs
/libbpf-bootstrap/examples/c/.output/
/libbpf-bootstrap/examples/c/execmon
/libbpf-bootstrap/examples/c/filemon
/libbpf-bootstrap/examples/c/hostmon
/libbpf-bootstrap/examples/c/modelmon

# bf-p4c output directories, wherever a program is compiled
*.tofino/

# Hardware benchmark runs: per-command logs, P4 builds, pcaps, register dumps
# and captures. They stay on disk; p4_perf.md is the summary.
# Exception: the per-probe latencies of the Section 4.1/5.5 hairpin runs
# (collect_reports.py output: packet_latencies.csv and summary.json).
/perf/results/**
!/perf/results/**/
!/perf/results/*/*_hairpin_r[0-9]/packet_latencies.csv
!/perf/results/*/*_hairpin_r[0-9]/summary.json
/perf/plots/

# Generated host monitoring outputs
/benign_ls_clean.csv
/process_summary.csv
/ctu13_s13_peak10.csv
/synthetic_testers.csv
/hybrid_labels.csv
/hybrid_windows.csv
/indexes_unique.txt
/hybrid_dataset_workdir/

# Local captures and test artifacts
*.log
/test_ebpf_logs/
/veth_sw_ext
/veth_sw_int