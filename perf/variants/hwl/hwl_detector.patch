diff -ru a/headers.p4 b/headers.p4
--- a/headers.p4
+++ b/headers.p4
@@ -46,6 +46,29 @@
     bit<16> checksum;
 }
 
+/* ASIC latency report, the measurement of reference_evaluation/P4_Code
+ * (perf/variants/hwl): ingress puts its parser timestamp into a bridge header,
+ * and egress inserts the 20-byte report after Ethernet of IPv4/UDP packets and
+ * sets EtherType 0x88BC. Decoded by that package's scripts/probe_format.py. */
+const bit<32> HW_LATENCY_MAGIC     = 0x48574C31;   /* "HWL1" */
+const bit<16> ETHERTYPE_HW_LATENCY = 0x88BC;
+const PortId_t HW_LATENCY_CPU_PORT = 192;          /* mirrored CPU reports: no bridge */
+
+header hw_latency_bridge_h {
+    bit<48> ingress_ns;
+    bit<8>  score;
+    bit<8>  tier;
+}
+
+header hw_latency_report_h {
+    bit<32> magic;
+    bit<16> original_ether_type;
+    bit<48> ingress_ns;
+    bit<48> egress_ns;
+    bit<8>  score;
+    bit<8>  tier;
+}
+
 /* Report payload mirrored to CPU/host (18 bytes, magic CPU_REPORT_MAGIC).
  * flow_index is the register bucket the data plane chose, so the collector
  * reads it from the report instead of recomputing the hash. */
@@ -63,6 +86,7 @@
 }
 
 struct my_headers_t {
+    hw_latency_bridge_h hw_bridge;
     ethernet_t ethernet;
     ipv4_t     ipv4;
     tcp_t      tcp;
@@ -101,7 +125,9 @@
 }
 
 struct my_egress_headers_t {
+    hw_latency_bridge_h hw_bridge;
     ethernet_t ethernet;
+    hw_latency_report_h hw_report;
     ipv4_t     ipv4;
     tcp_t      tcp;
     udp_t      udp;
