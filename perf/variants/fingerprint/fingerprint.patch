+#if P4_ENABLE_FINGERPRINT
+    /* Flow fingerprint: tells the bucket's first flow from another flow that
+     * lands in the same bucket. It must not be symmetric: every Tofino hash is
+     * an XOR matrix, and a symmetric one depends only on sip^dip and sp^dp, so
+     * flows with equal XORs would match. The bucket keeps the forward
+     * fingerprint of its first packet; a later packet belongs to that flow if
+     * its forward or its reverse fingerprint equals it. The polynomial (0x8BB7,
+     * reflected) differs from the index's, so the two hashes are independent. */
+    CRCPolynomial<bit<16>>(16w0x8BB7, true, false, false, 16w0x0000, 16w0x0000) fp_poly;
+    Hash<bit<16>>(HashAlgorithm_t.CUSTOM, fp_poly) fp_fwd_hasher;
+    Hash<bit<16>>(HashAlgorithm_t.CUSTOM, fp_poly) fp_rev_hasher;
